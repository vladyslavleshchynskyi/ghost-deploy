# Copy to .env and fill in. deploy.sh, destroy.sh and verify.sh load it automatically;
# variables already set in the environment take precedence. No inline comments.

# Reusable Tailscale auth key tagged tag:ghost (Settings -> Keys). Required for the first deploy.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx

# Login for the Ghost owner account (no mail is sent to it).
GHOST_ADMIN_EMAIL=admin@example.com
BLOG_TITLE=My Ghost Blog

# Optional overrides.
#STACK_NAME=ghost-blog
#AWS_REGION=eu-north-1
#INSTANCE_TYPE=t3.small
#TS_HOSTNAME=ghost
